// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  staff
  owner
  admin
}

enum Grade {
  BPS
  BOP
  BOPSM
  BP
  BPSM
  PF
  PD
  DUST
  CD
  BPS1
  BOPL1
  BOP1
  BOPSM1
  BP1
  BPSM1
  PF1
  PD1
  DUST1
  CD1
  OF
  BOPL
}

enum AuctionBroker {
  J_THOMAS
  CARRITT_MORAN
  PARAMOUNT
  CONTEMPORARY
  ATB
  PTM
  ASSAM_TEA_BROKERS
  OTHER
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      Role     @default(staff)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stock {
  id                 String    @id @default(uuid())
  inv                String?
  invNo              Int?
  grade              Grade?
  totalBags          Int?
  bagWt              Float?
  netWt              Float?
  dop                DateTime?
  broker             String?
  buyer              String?
  soldDate           DateTime?
  soldRate           Float?
  soldInvNo          Int?
  billNo             String?
  biltyNo            String?
  purchaseSample     Boolean?
  purchaseSampleDate DateTime?
  auction            Boolean?  @default(false)
  auctionNo          String?
  auctionDate        DateTime?
  auctionBroker      AuctionBroker?
  timestamp          DateTime  @default(now()) @updatedAt
  user               String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  editRequests       StockEditRequest[]
}

model StockEditRequest {
  id          String   @id @default(uuid())
  stockId     String
  stock       Stock    @relation(fields: [stockId], references: [id])
  newData     Json     // Stores the proposed fields to change
  status      String   @default("pending") // pending, approved, rejected
  requestedBy String   // username of the staff member
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StockMaster {
  id                 String    @id @default(uuid())
  inv                String?
  invNo              Int?
  grade              Grade?
  totalBags          Int?
  bagWt              Float?
  netWt              Float?
  dop                DateTime?
  broker             String?
  buyer              String?
  soldDate           DateTime?
  soldRate           Float?
  soldInvNo          Int?
  billNo             String?
  biltyNo            String?
  purchaseSample     Boolean?
  purchaseSampleDate DateTime?
  auction            Boolean?  @default(false)
  auctionNo          String?
  auctionDate        DateTime?
  auctionBroker      AuctionBroker?
  timestamp          DateTime  @default(now()) @updatedAt
  user               String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model UpdateOtp {
  id        String   @id @default(uuid())
  stockId   String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  role      Role     // To determine which roles see the notification
  metadata  Json?    // For storing custom payload (like ip, expiresAt)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
